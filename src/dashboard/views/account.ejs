<%
    function convert(boolean) {
        if(boolean) {
            return "Active";
        } else {
            return "Inactive";
        };
    };
%>

<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title><%= config.website.siteName %> - Account</title>
        <meta property="og:title" content="<%= config.website.siteName %> - Account" />
        <link rel="icon" href="/assets/logo.png">
        <meta property="og:image" content="/assets/logo.png">
        <meta name="theme-color" content="<%= config.themeColor %>">
        <meta name="description" content="<%= config.website.siteDescription %>" />
        <meta property="og:type" content="website" />
        <meta property="og:description" content="<%= config.website.siteDescription %>" />
    </head>
    <body>
        <%- include('_header', { config: config }) %>
        <br>
        <br>
        <div class="container text-white text-center bg-third container1">
            <br>
            <h1 class="worksans" style="font-weight: 700;">My Account</h1>
            <p>Below you can view your account!</p>
            <h3 class="worksans" style="font-weight: 600;">Banned Status</h3>
            <p id="<%= convert(banned) %>"><%= convert(banned) %></p>
            <% if(isStaff) { %>
                <a class="btn btn-primary" href="/staff">Staff Panel</a>
            <% }; %>
            <div class="modded-hr">
                <hr>
            </div>
            <div class="row justify-content-center">
                <h1 style="font-weight: 700;">Guild Management</h1>
                <p>Here is where you can manage all of guilds that you currently own.</p>
                <br><br>
                <% guilds.forEach(function(guild) { %>
                    <div class="col-sm-3 text-white text-center">
                        <img class="<%= guild.imgstyle %>" src="https://cdn.discordapp.com/icons/<%= guild.data.id %>/<%= guild.data.icon %>" style="height: 8em; width: 8em; border-radius: 50% !important; border-style: solid; border-width: 3px;">
                        <p style="margin-top: 0.6em; font-size: 1.2em;"><%= guild.data.name %></p>
                        <a class="btn <%= guild.btn %> <%= guild.style %>" href="<%= guild.link %>" target="<%= guild.target %>"><%= guild.button %></a>
                        <br><br><br>
                    </div>
                <% }); %>
            </div>
            <br>
        </div>
        <br><br><br><br><br>
        <%- include('_footer', { config: config }) %>
    </body>
</html>