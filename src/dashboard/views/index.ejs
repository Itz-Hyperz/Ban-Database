<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title><%= config.website.siteName %> - Home</title>
        <meta property="og:title" content="<%= config.website.siteName %> - Home" />
        <link rel="icon" href="/assets/logo.png">
        <meta property="og:image" content="/assets/logo.png">
        <meta name="theme-color" content="<%= config.themeColor %>">
        <meta name="description" content="<%= config.website.siteDescription %>" />
        <meta property="og:type" content="website" />
        <meta property="og:description" content="<%= config.website.siteDescription %>" />
    </head>
    <body>
        <%- include('_header', { config: config }) %>
        
        <div class="container text-white text-center container1">
            <!-- Hero -->
            <div class="row justify-content-center align-items-center mb-4">
                <div class="col-lg-5 container1col1 text-center text-lg-end mb-4 mb-lg-0">
                    <h1 class="worksans hero-title"><%= config.website.siteName %></h1>
                </div>
                <div class="col-lg-6 text-start text-lg-start worksans">
                    <div class="aboutText">
                        <%= config.website.siteDescription %>
                    </div>
                </div>
            </div>

            <div class="modded-hr"><hr></div>

            <!-- Reports & Appeals -->
            <div class="mb-2">
                <h2 class="worksans" style="font-weight: 700; margin-bottom: 0.5rem;">Reports & Appeals</h2>
                <p style="color: var(--text-secondary); margin-bottom: 2rem;">Create a report, submit an appeal, or search the database.</p>
                
                <div class="row justify-content-center g-4">
                    <div class="col-md-4">
                        <a class="hoverA" href="/report">
                            <div class="action-card">
                                <div class="iconhellyeah">
                                    <i class="fa-solid fa-bullhorn"></i>
                                </div>
                                <h2>Reports</h2>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a class="hoverA" href="/search">
                            <div class="action-card">
                                <div class="iconhellyeah">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </div>
                                <h2>Search</h2>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a class="hoverA" href="/appeal">
                            <div class="action-card">
                                <div class="iconhellyeah">
                                    <i class="fa-solid fa-person-praying"></i>
                                </div>
                                <h2>Appeals</h2>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="modded-hr"><hr></div>

            <!-- Stats -->
            <div class="row justify-content-center g-4">
                <div class="col-md-4">
                    <div class="stat-box">
                        <h3><%= guildcount %></h3>
                        <h2>Servers</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-box">
                        <h3><%= bancount %></h3>
                        <h2>Banned Users</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-box">
                        <h3><%= usercount %></h3>
                        <h2>Users</h2>
                    </div>
                </div>
            </div>
        </div>

        <%- include('_footer', { config: config }) %>
    </body>
</html>
